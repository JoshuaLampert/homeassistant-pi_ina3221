            "number": {
              "min": "0",
              "max": "127",
              "step": "1"
            }
          }
        },
        "scan_interval": {
          "name": "Abfrageintervall",
          "description": "Abfrageintervall in Sekunden (5-3600)",
          "selector": {
            "number": {
              "min": "5",
              "max": "3600",
              "step": "1",
