  "services": {
    "set_scan_interval": {
      "name": "Abfrageintervall festlegen",
      "description": "Legt das Abfrageintervall für ein bestimmtes INA3221-Gerät fest.",
      "fields": {
        "i2c_bus": {
          "name": "I2C-Bus",
