{
  "config": {
    "step": {
      "user": {
        "title": "Configure INA3221 Power Monitor",
        "description": "Set up your INA3221 sensor to monitor current, voltage, and power on three channels.",
        "data": {
          "i2c_bus": "I2C Bus Number",
          "i2c_address": "I2C Address (hex)",
          "shunt_ohms_ch1": "Channel 1 Shunt Resistor Value (Ohms)",
          "shunt_ohms_ch2": "Channel 2 Shunt Resistor Value (Ohms)",
          "shunt_ohms_ch3": "Channel 3 Shunt Resistor Value (Ohms)",
          "channel_1_enabled": "Enable Channel 1",
          "channel_2_enabled": "Enable Channel 2",
          "channel_3_enabled": "Enable Channel 3",
          "scan_interval": "Scan Interval (seconds)"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to INA3221 sensor. Please check your I2C bus, address, and wiring.",
      "unknown": "Unexpected error occurred"
    },
    "abort": {
      "already_configured": "Device is already configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Adjust INA3221 options",
        "data": {
          "scan_interval": "Scan Interval (seconds)"
        }
      }
    }
  },
  "services": {
    "set_scan_interval": {
      "name": "Set scan interval",
      "description": "Set the scan interval for a specific INA3221 device.",
      "fields": {
        "i2c_bus": {
          "name": "I2C Bus",
          "description": "I2C bus number (typically 1 on Raspberry Pi)",
          "selector": {
            "number": {
              "min": "0",
              "step": "1"
            }
          }
        },
        "i2c_address": {
          "name": "I2C Address",
          "description": "I2C address of the INA3221 device (hex, 0x00-0x7F)",
          "selector": {
            "number": {
              "min": "0",
              "max": "127",
              "step": "1"
            }
          }
        },
        "scan_interval": {
          "name": "Scan Interval",
          "description": "Scan interval in seconds (5-3600)",
          "selector": {
            "number": {
              "min": "5",
              "max": "3600",
              "step": "1",
              "unit_of_measurement": "s"
            }
          }
        }
      }
    }
  }
}
